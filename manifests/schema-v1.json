{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fitgirl-wine/manifest-v1.schema.json",
  "title": "FitGirl Wine installation manifest v1",
  "type": "object",
  "required": ["schema", "name", "setup_sha256", "components", "steps"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "draft": { "type": "boolean" },
    "review_required": { "type": "boolean" },
    "setup_sha256": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "default"],
        "properties": {
          "description": { "type": "string" },
          "default": { "type": "boolean" },
          "required": { "type": "boolean" },
          "available_if": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["extract", "batch", "verify"] },
          "description": { "type": "string" },
          "archive": { "type": "string" },
          "md5": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
          "destination": { "enum": ["app", "tmp", "scratch"] },
          "if_component": { "type": "string" },
          "unless_component": { "type": "string" },
          "script_root": { "enum": ["app", "tmp", "scratch"] },
          "script": { "type": "string" },
          "cwd": { "enum": ["app", "tmp", "scratch"] },
          "cwd_suffix": { "type": "string" },
          "manifest_root": { "enum": ["app", "tmp", "scratch", "payload_app"] },
          "manifest": { "type": "string" },
          "root": { "enum": ["app", "tmp", "scratch", "payload_app"] }
        }
      }
    }
  }
}
